# Environment Configuration
PROJECT_NAME="Agentic AI Research Paper Intelligence System"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkeyforresearchpaperplatform"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_papers_db
# Or for local dev without postgres running:
# DATABASE_URL=sqlite:///./research_papers.db

# Celery & Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM & AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Neo4j Graph DB Configuration (Optional / AuraDB / Local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchintelligence
